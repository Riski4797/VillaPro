      "name": "invoice_payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_payments\" (\"id\" TEXT NOT NULL, \"invoice_id\" TEXT NOT NULL, \"amount\" INTEGER NOT NULL DEFAULT 0, \"date_paid\" INTEGER NOT NULL, \"payment_method\" TEXT NOT NULL DEFAULT 'Transfer Bank', \"notes\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" TEXT NOT NULL DEFAULT 'default', \"business_name\" TEXT NOT NULL DEFAULT 'Villa Management & Reservations', \"tagline\" TEXT NOT NULL DEFAULT 'GUEST FOLIO & OFFICIAL INVOICE', \"admin_name\" TEXT NOT NULL DEFAULT 'Admin', \"admin_contact\" TEXT NOT NULL DEFAULT '', \"bank_accounts\" TEXT NOT NULL DEFAULT '- BCA: 123-456-7890 a.n. Villa Manager\n- Mandiri: 987-654-3210 a.n. Villa Manager', \"invoice_footer_note\" TEXT NOT NULL DEFAULT 'Harap simpan bukti pembayaran dan tunjukkan saat proses check-in.', \"template_teaser\" TEXT NOT NULL DEFAULT '{nama_villa} - {lokasi}\nHarga mulai {harga_weekday}/malam\n{keunggulan}\nMau info lengkap? Chat aja ya kak 🙏', \"template_detail\" TEXT NOT NULL DEFAULT '*{nama_villa}*\n📍 {lokasi}\n\n{deskripsi}\n\n✨ *Keunggulan:*\n{keunggulan}\n\n🏠 *Fasilitas:*\n{fasilitas}\n\n💰 *Tarif Sewa:*\n- Weekday: {harga_weekday}/malam\n- Weekend: {harga_weekend}/malam\n- High season: {harga_high_season}/malam\n\n📋 *Aturan Menginap:*\n{aturan}\n\nInfo booking & ketersediaan:\nHubungi {nama_admin} ({kontak_admin})', \"template_butler_notification\" TEXT NOT NULL DEFAULT 'Halo {nama_penjaga}, ada tamu yang akan check-in:\n• Villa: {nama_villa}\n• Tamu: {nama_tamu} ({kontak_tamu})\n• Jadwal: {tgl_checkin} s.d {tgl_checkout} ({jumlah_malam} malam)\nMohon dibantu persiapan villa & kunci ya. Terima kasih 🙏', PRIMARY KEY (\"id\"));"
        }
