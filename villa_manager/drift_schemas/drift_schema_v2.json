    {
      "name": "villas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villas\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"location\" TEXT NOT NULL DEFAULT '', \"owner_name\" TEXT NOT NULL DEFAULT '', \"owner_contact\" TEXT NOT NULL DEFAULT '', \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"description\" TEXT NOT NULL DEFAULT '', \"unique_selling_points\" TEXT NOT NULL DEFAULT '[]', \"amenities\" TEXT NOT NULL DEFAULT '[]', \"house_rules\" TEXT NOT NULL DEFAULT '', \"price_weekday\" INTEGER NOT NULL DEFAULT 0, \"price_weekend\" INTEGER NOT NULL DEFAULT 0, \"price_high_season\" INTEGER NOT NULL DEFAULT 0, \"commission_percent\" REAL NOT NULL DEFAULT 0.0, \"private_notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
