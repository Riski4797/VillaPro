  "fixed_sql": [
    {
      "name": "villas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villas\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"location\" TEXT NOT NULL DEFAULT '', \"owner_name\" TEXT NOT NULL DEFAULT '', \"owner_contact\" TEXT NOT NULL DEFAULT '', \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"description\" TEXT NOT NULL DEFAULT '', \"unique_selling_points\" TEXT NOT NULL DEFAULT '[]', \"amenities\" TEXT NOT NULL DEFAULT '[]', \"house_rules\" TEXT NOT NULL DEFAULT '', \"price_weekday\" INTEGER NOT NULL DEFAULT 0, \"price_weekend\" INTEGER NOT NULL DEFAULT 0, \"price_high_season\" INTEGER NOT NULL DEFAULT 0, \"commission_percent\" REAL NOT NULL DEFAULT 0.0, \"commission_type\" TEXT NOT NULL DEFAULT 'percent', \"commission_fixed\" INTEGER NOT NULL DEFAULT 0, \"private_notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "villa_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villa_photos\" (\"id\" TEXT NOT NULL, \"villa_id\" TEXT NOT NULL, \"file_path\" TEXT NOT NULL, \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "villa_faqs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villa_faqs\" (\"id\" TEXT NOT NULL, \"villa_id\" TEXT NOT NULL, \"question\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bookings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookings\" (\"id\" TEXT NOT NULL, \"villa_id\" TEXT NOT NULL, \"guest_name\" TEXT NOT NULL, \"guest_contact\" TEXT NOT NULL DEFAULT '', \"check_in\" INTEGER NOT NULL, \"check_out\" INTEGER NOT NULL, \"price_per_night_snapshot\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL DEFAULT 'confirmed', \"notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "invoices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoices\" (\"id\" TEXT NOT NULL, \"invoice_number\" TEXT NOT NULL, \"booking_id\" TEXT NOT NULL, \"guest_name\" TEXT NOT NULL, \"villa_name\" TEXT NOT NULL, \"check_in\" INTEGER NOT NULL, \"check_out\" INTEGER NOT NULL, \"status\" TEXT NOT NULL DEFAULT 'unpaid', \"date_issued\" INTEGER NOT NULL, \"date_paid\" INTEGER NULL, \"reminder_sent_at\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "invoice_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_items\" (\"id\" TEXT NOT NULL, \"invoice_id\" TEXT NOT NULL, \"description\" TEXT NOT NULL, \"qty\" INTEGER NOT NULL DEFAULT 1, \"price\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    }
  ]
