  "fixed_sql": [
    {
      "name": "villas",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villas\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"location\" TEXT NOT NULL DEFAULT '', \"owner_name\" TEXT NOT NULL DEFAULT '', \"owner_contact\" TEXT NOT NULL DEFAULT '', \"owner_bank\" TEXT NOT NULL DEFAULT '', \"butler_name\" TEXT NOT NULL DEFAULT '', \"butler_contact\" TEXT NOT NULL DEFAULT '', \"is_butler_same_as_owner\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_butler_same_as_owner\" IN (0, 1)), \"is_active\" INTEGER NOT NULL DEFAULT 1 CHECK (\"is_active\" IN (0, 1)), \"description\" TEXT NOT NULL DEFAULT '', \"unique_selling_points\" TEXT NOT NULL DEFAULT '[]', \"amenities\" TEXT NOT NULL DEFAULT '[]', \"house_rules\" TEXT NOT NULL DEFAULT '', \"price_weekday\" INTEGER NOT NULL DEFAULT 0, \"price_weekend\" INTEGER NOT NULL DEFAULT 0, \"price_high_season\" INTEGER NOT NULL DEFAULT 0, \"commission_percent\" REAL NOT NULL DEFAULT 0.0, \"commission_type\" TEXT NOT NULL DEFAULT 'percent', \"commission_fixed\" INTEGER NOT NULL DEFAULT 0, \"private_notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (price_weekday >= 0), CHECK (price_weekend >= 0), CHECK (price_high_season >= 0), CHECK (commission_percent >= 0 AND commission_percent <= 100), CHECK (commission_type IN ('percent', 'fixed')), CHECK (commission_fixed >= 0));"
        }
      ]
    },
    {
      "name": "villa_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villa_photos\" (\"id\" TEXT NOT NULL, \"villa_id\" TEXT NOT NULL REFERENCES villas (id) ON DELETE CASCADE, \"file_path\" TEXT NOT NULL, \"media_type\" TEXT NOT NULL DEFAULT 'photo', \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (media_type IN ('photo', 'video')), CHECK (sort_order >= 0));"
        }
      ]
    },
    {
      "name": "villa_faqs",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"villa_faqs\" (\"id\" TEXT NOT NULL, \"villa_id\" TEXT NOT NULL REFERENCES villas (id) ON DELETE CASCADE, \"question\" TEXT NOT NULL, \"answer\" TEXT NOT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bookings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bookings\" (\"id\" TEXT NOT NULL, \"villa_id\" TEXT NOT NULL REFERENCES villas (id) ON DELETE RESTRICT, \"guest_name\" TEXT NOT NULL, \"guest_contact\" TEXT NOT NULL DEFAULT '', \"check_in\" INTEGER NOT NULL, \"check_out\" INTEGER NOT NULL, \"price_per_night_snapshot\" INTEGER NOT NULL DEFAULT 0, \"commission_type_snapshot\" TEXT NOT NULL DEFAULT 'percent', \"commission_percent_snapshot\" REAL NOT NULL DEFAULT 0.0, \"commission_fixed_snapshot\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL DEFAULT 'confirmed', \"notes\" TEXT NOT NULL DEFAULT '', \"created_at\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK (check_out > check_in), CHECK (price_per_night_snapshot >= 0), CHECK (status IN ('confirmed', 'cancelled')), CHECK (commission_type_snapshot IN ('percent', 'fixed')), CHECK (commission_percent_snapshot >= 0 AND commission_percent_snapshot <= 100), CHECK (commission_fixed_snapshot >= 0));"
        }
      ]
    },
    {
      "name": "invoices",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoices\" (\"id\" TEXT NOT NULL, \"invoice_number\" TEXT NOT NULL, \"booking_id\" TEXT NOT NULL REFERENCES bookings (id) ON DELETE RESTRICT, \"guest_name\" TEXT NOT NULL, \"villa_name\" TEXT NOT NULL, \"check_in\" INTEGER NOT NULL, \"check_out\" INTEGER NOT NULL, \"commission_type_snapshot\" TEXT NOT NULL DEFAULT 'percent', \"commission_percent_snapshot\" REAL NOT NULL DEFAULT 0.0, \"commission_fixed_snapshot\" INTEGER NOT NULL DEFAULT 0, \"status\" TEXT NOT NULL DEFAULT 'unpaid', \"date_issued\" INTEGER NOT NULL, \"date_paid\" INTEGER NULL, \"reminder_sent_at\" INTEGER NULL, PRIMARY KEY (\"id\"), UNIQUE (\"invoice_number\"), UNIQUE (\"booking_id\"), CHECK (check_out > check_in), CHECK (status IN ('unpaid', 'partial', 'paid')), CHECK (commission_type_snapshot IN ('percent', 'fixed')), CHECK (commission_percent_snapshot >= 0 AND commission_percent_snapshot <= 100), CHECK (commission_fixed_snapshot >= 0));"
        }
      ]
    },
    {
      "name": "invoice_items",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_items\" (\"id\" TEXT NOT NULL, \"invoice_id\" TEXT NOT NULL REFERENCES invoices (id) ON DELETE CASCADE, \"description\" TEXT NOT NULL, \"qty\" INTEGER NOT NULL DEFAULT 1, \"price\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"), CHECK (qty > 0), CHECK (price >= 0));"
        }
      ]
    },
    {
      "name": "invoice_payments",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"invoice_payments\" (\"id\" TEXT NOT NULL, \"invoice_id\" TEXT NOT NULL REFERENCES invoices (id) ON DELETE CASCADE, \"amount\" INTEGER NOT NULL DEFAULT 0, \"date_paid\" INTEGER NOT NULL, \"payment_method\" TEXT NOT NULL DEFAULT 'Transfer Bank', \"notes\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"), CHECK (amount > 0));"
        }
      ]
    },
    {
      "name": "app_settings",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"app_settings\" (\"id\" TEXT NOT NULL DEFAULT 'default', \"business_name\" TEXT NOT NULL DEFAULT 'Villa Management & Reservations', \"tagline\" TEXT NOT NULL DEFAULT 'GUEST FOLIO & OFFICIAL INVOICE', \"logo_path\" TEXT NOT NULL DEFAULT '', \"admin_name\" TEXT NOT NULL DEFAULT 'Admin', \"admin_contact\" TEXT NOT NULL DEFAULT '', \"bank_accounts\" TEXT NOT NULL DEFAULT '', \"invoice_footer_note\" TEXT NOT NULL DEFAULT 'Harap simpan bukti pembayaran dan tunjukkan saat proses check-in.', \"template_teaser\" TEXT NOT NULL DEFAULT '{nama_villa} - {lokasi}\nHarga mulai {harga_weekday}/malam\n{keunggulan}\nMau info lengkap? Chat aja ya kak 🙏', \"template_detail\" TEXT NOT NULL DEFAULT '*{nama_villa}*\n📍 {lokasi}\n\n{deskripsi}\n\n✨ *Keunggulan:*\n{keunggulan}\n\n🏠 *Fasilitas:*\n{fasilitas}\n\n💰 *Tarif Sewa:*\n- Weekday: {harga_weekday}/malam\n- Weekend: {harga_weekend}/malam\n- High season: {harga_high_season}/malam\n\n📋 *Aturan Menginap:*\n{aturan}\n\nInfo booking & ketersediaan:\nHubungi {nama_admin} ({kontak_admin})', \"template_butler_notification\" TEXT NOT NULL DEFAULT 'Halo {nama_penjaga}, ada tamu yang akan check-in:\n• Villa: {nama_villa}\n• Tamu: {nama_tamu} ({kontak_tamu})\n• Jadwal: {tgl_checkin} s.d {tgl_checkout} ({jumlah_malam} malam)\nMohon dibantu persiapan villa & kunci ya. Terima kasih 🙏', PRIMARY KEY (\"id\"));"
        }
      ]
    },
